# ============================================================
# DevLens AI — Frontend Environment Variables
# Copy to .env and adjust for local or production deployments.
# ============================================================

# Backend FastAPI URL (no trailing slash)
# Local: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Client API authentication key matching backend API_KEY
VITE_API_KEY=your-api-key-here
